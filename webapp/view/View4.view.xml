<mvc:View
    controllerName="com.demo.demoempmanagement.controller.View4"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:u="sap.ui.unified">
    <Page id="page4" title="I am View4" showNavButton="true" navButtonPress="onBackPress">
    <content>
        <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanL="2" labelSpanM="2" emptySpanL="6" emptySpanM="6" >
        <Label text="Employee Id"></Label>
        <Input id="oIpEmpIdV4" value="{oModel>Empid}" enabled="false"></Input>
        <Label text="Name"></Label>
        <Input id="oIpEmpNameV4" value="{oModel>Name}"></Input>
        <Label text="Designation"></Label>
        <Input id="oIpEmpDesigV4" value="{oModel>Desig}"></Input>
        <Label text="Email"></Label>
        <Input id="oIpEmpEmailV4" value="{oModel>Email}"></Input>
        <Label text="Salary"></Label>
        <Input id="oIpEmpSalaryV4" value="{oModel>Salary}"></Input>
        <Label text="Status"></Label>
        <Input id="oIpEmpStatusV4" value="{oModel>Status}"></Input>
        <Label text="Rating"></Label>
        <Input id="oIpEmpRatingV4" value="{oModel>Rating}"></Input>
        <Label text="Upload your new photo"/>
        <u:FileUploader id="oFileUpoaderPhoto1" uploadUrl="/sap/opu/odata/sap/ZEMP_DEMO_SRV/PhotoSet" sendXHR="true" useMultipart="false"  buttonText="Upload Photo"
        change="onSelcFile" uploadComplete="OnFileUpload"></u:FileUploader>
        </f:SimpleForm>

        <Table class="sapUiSmallMargin" width="auto" items="{certUpdateModel>/results}">
            <headerToolbar> 
                <Toolbar>
                    <Title text="Certification Details"></Title>
                    <ToolbarSpacer ></ToolbarSpacer>
                    <Button icon="sap-icon://add" type="Emphasized" press="onAddPress"></Button>
                </Toolbar>
            </headerToolbar>

            <columns>
                <Column >
                    <Label text="Employee Id"></Label>
                </Column>
                 <Column >
                    <Label text="Certification Id"></Label>
                </Column>
                <Column >
                    <Label text="Certification name"></Label>
                </Column>
                <Column >
                    <Label text="Description"></Label>
                </Column>
                <Column >
                    <Label text="Status"></Label>
                </Column>
                <Column >
                    <Label text="Delete"></Label>
                </Column>
            </columns>

            <items>
                <ColumnListItem >
                    <Input value="{certUpdateModel>Empid}" enabled="false"></Input>
                    <Input value="{certUpdateModel>Certid}"></Input>
                    <Input value="{certUpdateModel>Certname}"></Input>
                    <Input value="{certUpdateModel>Description}"></Input>
                    <Input value="{certUpdateModel>Status}"></Input>
                    <Button icon="sap-icon://delete" type="Reject" press="onRemovePress"></Button>
                </ColumnListItem>
            </items>

            </Table>

    </content>

    <footer>
        <Bar >
            <contentRight>
                <Button text="Save" press="onSavePress" type="Emphasized"></Button>
            </contentRight>
        </Bar>
    </footer>
    </Page>

</mvc:View>
