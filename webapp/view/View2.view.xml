<mvc:View
    controllerName="com.demo.demoempmanagement.controller.View2"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form">
    <Page id="page2" title="I am View2" showNavButton="true" navButtonPress="onBackPress">

    <content>
        <ObjectHeader iconActive="true" iconPress="onIconPress" icon="/sap/opu/odata/sap/ZEMP_DEMO_SRV/PhotoSet('{oModel>Empid}')/$value" imageShape="Circle" title="{oModel>Name}" number="{oModel>Salary}" numberUnit="INR">
            <attributes>
                <ObjectAttribute title="Employee Id" text="{oModel>Empid}"></ObjectAttribute>
                <ObjectAttribute title="Designation" text="{oModel>Desig}"></ObjectAttribute>
            </attributes>

            <statuses>
                <ObjectStatus text="{oModel>Status}" state="{path:'oModel>Status',formatter:'.f.formatStatus'}" inverted="true"></ObjectStatus>
            </statuses>
        </ObjectHeader>


        <IconTabBar>
            <items>
                <IconTabFilter icon="sap-icon://information">
                    <f:SimpleForm id="oSFEmpDetails" editable="false">
                        <Label text="Employee Id" />
                        <Text text="{oModel>Empid}" />
                        <Label text="Name" />
                        <Text text="{oModel>Name}" />
                        <Label text="Designation" />
                        <Text text="{oModel>Desig}" />
                        <Label text="Email" />
                        <Text text="{oModel>Email}" />
                        <Label text="Status" />
                        <ObjectStatus text="{oModel>Status}" state="{path:'oModel>Status',formatter:'.f.formatStatus'}"></ObjectStatus>
                        <Label text="Rating" />
                        <Text text="{path:'oModel>Rating',formatter:'.f.formatRating'}" />
                    </f:SimpleForm>
                </IconTabFilter>

                <IconTabFilter icon="sap-icon://validate">
                    <Table items="{oModel>toCertification}">
                        <columns>
                            <Column >
                                <Label text="Employee Id"></Label>
                            </Column>
                            <Column >
                                <Label text="Certification Id"></Label>
                            </Column>
                            <Column >
                                <Label text="Certification name"></Label>
                            </Column>
                            <Column >
                                <Label text="Description"></Label>
                            </Column>
                            <Column >
                                <Label text="Status"></Label>
                            </Column>
                        </columns>

                        <items>
                            <ColumnListItem >
                                <Text text="{oModel>Empid}"></Text>
                                <Text text="{oModel>Certid}"></Text>
                                <Text text="{oModel>Certname}"></Text>
                                <Text text="{oModel>Description}"></Text>
                                <Text text="{oModel>Status}"></Text>
                            </ColumnListItem>
                        </items>
                    </Table>

                
                </IconTabFilter>
            </items>
        </IconTabBar>
    </content>
    </Page>
</mvc:View>
