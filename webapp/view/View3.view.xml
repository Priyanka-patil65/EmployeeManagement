<mvc:View
    controllerName="com.demo.demoempmanagement.controller.View3"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form">
    <Page id="page3" title="I am View3" showNavButton="true" navButtonPress="onBackPress">
    <content>
        <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanL="2" labelSpanM="2" emptySpanL="6" emptySpanM="6" >
        <Label text="Employee Id"></Label>
        <Input id="oIpEmpId"></Input>
        <Label text="Name"></Label>
        <Input id="oIpEmpName"></Input>
        <Label text="Designation"></Label>
        <Input id="oIpEmpDesig"></Input>
        <Label text="Email"></Label>
        <Input id="oIpEmpEmail"></Input>
        <Label text="Salary"></Label>
        <Input id="oIpEmpSalary"></Input>
        <Label text="Status"></Label>
        <Input id="oIpEmpStatus"></Input>
        <Label text="Rating"></Label>
        <Input id="oIpEmpRating"></Input>
        </f:SimpleForm>
        
        <Table class="sapUiSmallMargin" width="auto" items="{certModel>/aCertifications}">
            <headerToolbar> 
                <Toolbar>
                    <Title text="Certification Details"></Title>
                    <ToolbarSpacer ></ToolbarSpacer>
                    <Button icon="sap-icon://add" type="Emphasized" press="onAddPress"></Button>
                </Toolbar>
            </headerToolbar>

            <columns>
                <Column >
                    <Label text="Employee Id"></Label>
                </Column>
                 <Column >
                    <Label text="Certification Id"></Label>
                </Column>
                <Column >
                    <Label text="Certification name"></Label>
                </Column>
                <Column >
                    <Label text="Description"></Label>
                </Column>
                <Column >
                    <Label text="Status"></Label>
                </Column>
                <Column >
                    <Label text="Delete"></Label>
                </Column>
            </columns>

            <items>
                <ColumnListItem >
                    <Input value="{certModel>Empid}" enabled="false"></Input>
                    <Input value="{certModel>Certid}"></Input>
                    <Input value="{certModel>Certname}"></Input>
                    <Input value="{certModel>Description}"></Input>
                    <Input value="{certModel>Status}"></Input>
                    <Button icon="sap-icon://delete" type="Reject" press="onRemovePress"></Button>
                </ColumnListItem>
            </items>
            
        </Table>
    </content>

    <footer>
        <Bar >
            <contentRight>
                <Button text="Save" press="onSavePress" type="Emphasized"></Button>
            </contentRight>
        </Bar>
    </footer>
    </Page>

</mvc:View>
