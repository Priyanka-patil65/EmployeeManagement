        <!-- -->

        <Panel headerText="Filter/Sort Employees" expanded="false" expandable="true">
            <content>
            <f:SimpleForm editable="true" columnsL="3" columnsM="3" layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4" emptySpanL="0" emptySpanM="0">
            <core:Title text="Filters"> </core:Title>
            <Label text="Employee Id" />
            <Input id="f4HelpIpt" showValueHelp="true" valueHelpRequest="onF4helpPress"></Input>
            <Label text="Name"/>
            <Input id="nameIpt"/>
            <Label text="Skill" />
            <Input id="skillIpt" />
            <Label text="Desig" />
            <Input id="desigIpt" />

            <core:Title text="Sorting" />
            <Label text="Sorting Field" />
            <ComboBox id="sortCmb">
                <items>
                    <core:Item text="Name" key="Name"></core:Item>
                    <core:Item text="EmpId" key="Empid"></core:Item>
                    <core:Item text="Skill" key="Skill"></core:Item>
                    <core:Item text="Designation" key="Desig"></core:Item>
                </items>
            </ComboBox>

            <Label text="Sorting Order" />
            <RadioButtonGroup columns="2" id="orderRBG" selectedIndex="-1">
            <RadioButton text="Ascending"></RadioButton>
            <RadioButton text="Descending"></RadioButton>
            </RadioButtonGroup>

            <core:Title text="Grouping" />
            <Label text="Grouping Field" />
            <ComboBox id="groupCmb">
                <items>
                    <core:Item text="Skill" key="Skill"></core:Item>
                    <core:Item text="Designation" key="Desig"></core:Item>
                </items>
            </ComboBox>

            <Label text="Grouping Order" />
            <RadioButtonGroup columns="2" id="groupRBG" selectedIndex="-1">
            <RadioButton text="Ascending"></RadioButton>
            <RadioButton text="Descending"></RadioButton>
            </RadioButtonGroup>
            </f:SimpleForm>

            <FlexBox justifyContent="End">
                <Button text="Go" icon="sap-icon://accept" type="Emphasized" class="sapUiTinyMarginEnd" press="onGoPress"/>
                <Button text="Reset" type="Reject" icon="sap-icon://reset" press="onResetPress"/>
            </FlexBox>
        </content>
        </Panel>

        <Table id="empTab" items="{oModel>/EmployeeSet}" mode="SingleSelectLeft">
            <headerToolbar>
                <Toolbar >
                    <Title text="Employee Details" textAlign="Center"/> 
                    <ToolbarSpacer ></ToolbarSpacer>
                    <Button text="Add Employee" icon="sap-icon://add" press="onAddEmpPress" type="Emphasized" />
                    <Button text="Update Employee" icon="sap-icon://edit" press="onUpdatePress" type="Emphasized" />
                    <Button text="Delete Employee" icon="sap-icon://delete" press="onDeletePress" type="Emphasized" />

                </Toolbar>
            
                
            </headerToolbar>

            <columns>
                <Column >
                    <Label text="Employee Id" />
                </Column>
                <Column >
                    <Label text="Name" />
                </Column>
                <Column >
                    <Label text="Designation" />
                </Column>
                <Column >
                    <Label text="Skill" />
                </Column>
                <Column >
                    <Label text="Status" />
                </Column>
                <Column >
                    <Label text="Rating" />
                </Column>
            </columns>

            <items>
                <ColumnListItem type="Navigation" press="onRowSelect" >
                    <Text text="{oModel>Empid}" />
                    <Text text="{oModel>Name}" />
                    <Text text="{path:'oModel>Desig',formatter:'.f.formatDesig'}" />
                    <Text text="{oModel>Skill}" />
                    <ObjectStatus text="{oModel>Status}" state="{path:'oModel>Status',formatter:'.f.formatStatus'}" inverted="true"></ObjectStatus>
                    <Text text="{path:'oModel>Rating',formatter:'.f.formatRating'}" />
                </ColumnListItem>
            </items>
        
        </Table> 

        

